{
  "name": "source-x/dynamic-pricing",
  "type": "project",
  "description": "Source X backend-driven dynamic pricing engine prototype",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^12.0",
    "inertiajs/inertia-laravel": "^2.0"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "laravel/pint": "^1.21",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.6",
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {"psr-4": {"App\\": "app/", "Database\\Factories\\": "database/factories/", "Database\\Seeders\\": "database/seeders/"}},
  "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
  "scripts": {"post-autoload-dump": ["@php artisan package:discover --ansi"]},
  "minimum-stability": "stable",
  "prefer-stable": true
}
